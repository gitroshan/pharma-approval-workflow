# ---------------------------------------------------------------------------
# Sample environment configuration.
# Copy to `.env` and adjust. NEVER commit a real `.env` to version control.
# ---------------------------------------------------------------------------

# --- Core API ---
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call the API (frontend URL)
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL) ---
# Used by Prisma. In docker-compose the host is `db`.
DATABASE_URL=postgresql://app:app@localhost:5432/approval?schema=public

# --- Authentication ---
# Generate a strong secret in real deployments, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-in-production-use-a-32-byte-random-value
JWT_EXPIRES_IN=8h
# bcrypt work factor
BCRYPT_ROUNDS=12

# --- External internal platforms (mock services in this sample) ---
# Platform A: Document Management System
DMS_BASE_URL=http://localhost:5101
DMS_API_KEY=dms-sample-key
# Platform B: Identity / Authority directory
IDENTITY_BASE_URL=http://localhost:5102
IDENTITY_API_KEY=identity-sample-key
